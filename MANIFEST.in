# SPDX-License-Identifier: Apache-2.0
#
# What the sdist carries beyond setuptools' defaults. The wheel needs none of this: it is
# built from the installed package and its licence files are declared in pyproject.toml.
#
# The test suite, so a published source archive can be tested as published. `tests/_fakes.py`
# is the reason this file exists: it is not named `test_*`, so setuptools' automatic
# inclusion left it out and the suite could not run from the archive at all.
recursive-include tests *.py
# The licence files that ship alongside the published ones: LICENSE and NOTICE are declared
# in pyproject.toml, these are the rest of what REUSE reads.
include REUSE.toml
recursive-include LICENSES *
