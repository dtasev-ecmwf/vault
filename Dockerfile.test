# The offline test gate. pytest and coverage.py are only needed here; the suite
# itself is stdlib unittest and runs anywhere with no installs.
FROM python:3.14-slim-trixie AS tests
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir pytest coverage
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src COVERAGE_FILE=/tmp/.coverage
CMD ["sh", "-c", \
     "python -m coverage run --source=ecmwf_vault --branch -m pytest -q -p no:cacheprovider tests && python -m coverage report --fail-under=99"]
